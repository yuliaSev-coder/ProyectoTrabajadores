<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProyectoTrabajadores">

        <!-- Pantalla principal: Formulario de alta de trabajadores -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.example.proyectotrabajadores.task"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de detalle / Ficha con sonido y foto grande -->
        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:taskAffinity="com.example.proyectotrabajadores.task"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de listado / RecyclerView con el historial -->
        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:taskAffinity="com.example.proyectotrabajadores.task"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
